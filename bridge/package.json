{
  "name": "rivalsradio-bridge",
  "version": "0.1.0",
  "description": "Overwolf ow-electron bridge that reports the current Marvel Rivals hero to RivalsRadio over stdout.",
  "author": "RivalsRadio",
  "license": "MIT",
  "main": "src/main.js",
  "scripts": {
    "start": "ow-electron .",
    "dist": "ow-electron-builder --win --publish never"
  },
  "overwolf": {
    "packages": ["gep"]
  },
  "build": {
    "appId": "com.rivalsradio.bridge",
    "productName": "RivalsRadioBridge",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "index.html",
      "package.json"
    ],
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "RivalsRadioBridge.exe"
    }
  },
  "devDependencies": {
    "@overwolf/ow-electron": "latest",
    "@overwolf/ow-electron-builder": "latest"
  }
}
