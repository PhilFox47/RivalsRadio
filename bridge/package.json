{
  "name": "rivalsradio-bridge",
  "version": "0.1.0",
  "description": "Overwolf ow-electron bridge that reports the current Marvel Rivals hero to RivalsRadio.",
  "productName": "RivalsRadio",
  "author": {
    "name": "RivalsRadio"
  },
  "license": "MIT",
  "main": "src/main.js",
  "scripts": {
    "start": "ow-electron .",
    "dist": "ow-electron-builder --win --publish never"
  },
  "overwolf": {
    "packages": ["gep", "overlay"]
  },
  "build": {
    "appId": "com.rivalsradio.bridge",
    "productName": "RivalsRadioBridge",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "index.html",
      "package.json"
    ],
    "win": {
      "target": "dir"
    }
  },
  "devDependencies": {
    "@overwolf/ow-electron": "39.6.1",
    "@overwolf/ow-electron-builder": "latest"
  }
}
